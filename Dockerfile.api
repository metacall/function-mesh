FROM rust:1.94-alpine AS meta-ast-builder
RUN apk add --no-cache build-base musl-dev
ARG META_AST_VERSION=0.4.0
RUN if [ -n "$META_AST_VERSION" ]; then \
      cargo install meta-ast --version "$META_AST_VERSION" --features metacall-deploy --locked; \
    else \
      cargo install meta-ast --features metacall-deploy --locked; \
    fi
RUN meta-ast --version

FROM golang:1.26 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/api ./cmd/api

FROM alpine:3.22
RUN apk add --no-cache ca-certificates git
COPY --from=builder /out/api /api
COPY --from=meta-ast-builder /usr/local/cargo/bin/meta-ast /usr/local/bin/meta-ast
RUN meta-ast --version
USER 65532:65532
ENTRYPOINT ["/api"]
