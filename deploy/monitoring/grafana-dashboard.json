    {"type":"timeseries","title":"Invocation Rate","id":17,"gridPos":{"h":7,"w":6,"x":0,"y":22},"targets":[{"expr":"sum by (status) (rate(metacall_runtime_call_total{function=~\"$function\"}[5m]))","legendFormat":"{{status}}","refId":"A"}]},
    {"type":"timeseries","title":"Invocation Latency p99","id":18,"gridPos":{"h":7,"w":6,"x":6,"y":22},"fieldConfig":{"defaults":{"unit":"s"}},"targets":[{"expr":"histogram_quantile(0.99, sum by (le) (rate(metacall_runtime_call_duration_seconds_bucket{function=~\"$function\"}[5m])))","refId":"A"}]},
