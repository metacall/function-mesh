    {"type":"timeseries","title":"API Request Rate","id":11,"gridPos":{"h":7,"w":6,"x":12,"y":7},"targets":[{"expr":"sum by (method, path, status) (rate(metacall_api_request_total[5m]))","legendFormat":"{{method}} {{path}} {{status}}","refId":"A"}]},
