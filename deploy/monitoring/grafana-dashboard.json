    {"type":"timeseries","title":"Router Call Rate","id":13,"gridPos":{"h":7,"w":8,"x":0,"y":14},"targets":[{"expr":"sum by (function, status) (rate(metacall_call_total[5m]))","legendFormat":"{{function}} {{status}}","refId":"A"}]},
