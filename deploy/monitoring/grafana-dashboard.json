    {"type":"timeseries","title":"DNS Query Rate","id":32,"gridPos":{"h":7,"w":8,"x":16,"y":53},"targets":[{"expr":"sum by (source_pod, query) (rate(hubble_dns_queries_total{source_namespace=\"metacall-functions\"}[5m]))","legendFormat":"{{source_pod}} {{query}}","refId":"A"}]},
