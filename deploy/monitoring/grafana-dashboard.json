    {"type":"timeseries","title":"Function Pod Network I/O","id":27,"gridPos":{"h":8,"w":8,"x":16,"y":37},"fieldConfig":{"defaults":{"unit":"Bps"}},"targets":[{"expr":"sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"metacall-functions\"}[5m]))","legendFormat":"{{pod}} receive","refId":"A"},{"expr":"sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"metacall-functions\"}[5m]))","legendFormat":"{{pod}} transmit","refId":"B"}]},
    {"type":"timeseries","title":"Persistent Volume Usage","id":28,"gridPos":{"h":7,"w":24,"x":0,"y":45},"fieldConfig":{"defaults":{"unit":"bytes"}},"targets":[{"expr":"kubelet_volume_stats_used_bytes","legendFormat":"{{namespace}}/{{persistentvolumeclaim}}","refId":"A"}]},

