  "panels": [
    {"type":"row","title":"Cluster Overview","id":1,"gridPos":{"h":1,"w":24,"x":0,"y":0},"collapsed":false,"panels":[]},
    {"type":"stat","title":"Total Functions","id":2,"gridPos":{"h":5,"w":4,"x":0,"y":1},"targets":[{"expr":"count(kube_customresource_metacall_function_info)","refId":"A"}]},
    {"type":"piechart","title":"Functions by Phase","id":3,"gridPos":{"h":5,"w":5,"x":4,"y":1},"targets":[{"expr":"sum by (phase) (kube_customresource_metacall_function_info)","legendFormat":"{{phase}}","refId":"A"}]},
    {"type":"stat","title":"Running Function Pods","id":4,"gridPos":{"h":5,"w":3,"x":9,"y":1},"targets":[{"expr":"sum(kube_pod_status_phase{namespace=\"metacall-functions\",phase=\"Running\"})","refId":"A"}]},
    {"type":"gauge","title":"Cluster CPU Used","id":5,"gridPos":{"h":5,"w":4,"x":12,"y":1},"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}},"targets":[{"expr":"100 * sum(rate(node_cpu_seconds_total{mode!=\"idle\"}[5m])) / sum(rate(node_cpu_seconds_total[5m]))","refId":"A"}]},
    {"type":"stat","title":"Function Mesh Memory Used","description":"Current container working-set memory in metacall-system and metacall-functions. This excludes duplicated kind node totals.","id":6,"gridPos":{"h":5,"w":4,"x":16,"y":1},"fieldConfig":{"defaults":{"unit":"bytes"}},"targets":[{"expr":"sum(container_memory_working_set_bytes{namespace=~\"metacall-system|metacall-functions\",container!=\"\",image!=\"\"})","refId":"A"}]},
    {"type":"stat","title":"Managed PVC Storage Used","description":"Actual bytes used by persistent volumes in Function Mesh and monitoring namespaces. Node filesystem totals are intentionally excluded because kind exposes shared host-backed mounts on every node.","id":7,"gridPos":{"h":5,"w":4,"x":20,"y":1},"fieldConfig":{"defaults":{"unit":"bytes"}},"targets":[{"expr":"sum(kubelet_volume_stats_used_bytes{namespace=~\"metacall-system|metacall-functions|monitoring\"})","refId":"A"}]},

